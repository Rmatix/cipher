{
  "name": "cipher",
  "version": "0.1.0",
  "description": "Open source code editor with multi-model AI agent",
  "main": "src/main/index.js",
  "author": "Rmatix",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"cd renderer && pnpm dev\" \"wait-on http://localhost:5173 && set NODE_ENV=development&& electron .\"",
    "build": "cd renderer && pnpm build",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder --win --x64",
    "lint": "cd renderer && pnpm lint",
    "preview": "cd renderer && pnpm preview"
  },
  "build": {
    "appId": "com.rmatix.cipher",
    "productName": "Cipher",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "src/renderer-dist/**/*",
      "renderer/public/logo.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "renderer/public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "file-icons-js": "^1.1.0",
    "monaco-editor": "^0.55.1",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.1.0"
  }
}
