{
  "name": "cipher",
  "version": "2.8.0",
  "description": "Open source code editor with multi-model AI agent",
  "main": "src/main/index.js",
  "author": "Rmatix",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"cd renderer && pnpm dev\" \"wait-on http://localhost:5173 && set NODE_ENV=development && electron .\"",
    "build": "cd renderer && pnpm build",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:lite": "node scripts/build-all.js lite",
    "dist:dev": "node scripts/build-all.js dev",
    "dist:studio": "node scripts/build-all.js studio",
    "dist:all": "node scripts/build-all.js all",
    "dist:win": "node scripts/build-all.js all",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:linux": "pnpm build && electron-builder --linux",
    "lint": "cd renderer && pnpm lint",
    "preview": "cd renderer && pnpm preview"
  },
  "build": {
    "appId": "com.rmatix.cipher",
    "productName": "Cipher",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "src/renderer-dist/**/*",
      "renderer/public/logo.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "forceCodeSigning": false,
      "icon": "renderer/public/logo.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "renderer/public/logo.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "icon": "renderer/public/logo.png",
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "renderer/public/logo.ico",
      "uninstallerIcon": "renderer/public/logo.ico",
      "installerHeaderIcon": "renderer/public/logo.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "perMachine": false,
      "license": null
    },
    "extraResources": [
      "native/*.node"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.0",
    "concurrently": "^10.0.3",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "sharp": "^0.35.1",
    "wait-on": "^9.0.10"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.9",
    "file-icons-js": "^1.1.0",
    "monaco-editor": "^0.55.1",
    "mssql": "^12.5.5",
    "mysql2": "^3.22.5",
    "node-fetch": "^2.7.0",
    "node-pty": "^1.1.0",
    "pg": "^8.21.0"
  },
  "overrides": {
    "shell-quote": "^1.8.4",
    "dompurify": ">=3.4.9",
    "form-data": "^4.0.6",
    "request>form-data": "^2.5.6",
    "lodash": "^4.17.24",
    "uuid": "^11.1.1",
    "qs": "^6.14.1",
    "tough-cookie": "^4.1.3",
    "request": "^2.88.2",
    "undici": "^6.27.0",
    "@electron/get>undici": "^7.28.0"
  },
  "onlyBuiltDependencies": [
    "better-sqlite3",
    "node-pty"
  ]
}