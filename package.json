{
  "name": "cipher",
  "version": "2.8.1",
  "description": "Open source code editor (Cipher Studio) with multi-model AI agent",
  "main": "src/main/index.js",
  "author": {
    "name": "Rmatix",
    "email": "contact@rmatix.dev"
  },
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"cd renderer && pnpm dev\" \"wait-on http://localhost:5173 && set NODE_ENV=development && electron .\"",
    "build": "cd renderer && pnpm build",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder",
    "dist:win": "pnpm build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.rmatix.cipher.studio",
    "productName": "Cipher Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/main/**/*",
      "src/renderer-dist/**/*",
      "renderer/public/logo.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "forceCodeSigning": false,
      "icon": "renderer/public/logo.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "renderer/public/logo.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "icon": "renderer/public/logo.png",
      "category": "Development",
      "desktop": {
        "Name": "Cipher Studio",
        "Comment": "Open source code editor with multi-model AI agent",
        "Categories": "Development;IDE;"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "renderer/public/logo.ico",
      "uninstallerIcon": "renderer/public/logo.ico",
      "installerHeaderIcon": "renderer/public/logo.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "perMachine": false,
      "license": null
    },
    "extraResources": [
      "native/*.node"
    ],
    "asarUnpack": [
      "**/*.node",
      "**/better-sqlite3/**"
    ]
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.7.4",
    "concurrently": "^10.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.3",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.1",
    "electron-updater": "^6.8.9",
    "file-icons-js": "^1.1.0",
    "monaco-editor": "^0.56.0",
    "mssql": "^12.7.0",
    "mysql2": "^3.23.2",
    "node-fetch": "^3.3.2",
    "node-pty": "^1.1.0",
    "pg": "^8.22.0"
  },
  "onlyBuiltDependencies": [
    "better-sqlite3",
    "node-pty"
  ]
}